# Copy selected values to the repository root .env file. Never commit secrets.

# Hosted model credentials
ANTHROPIC_API_KEY=
ZAI_API_KEY=

# Optional Claude Code subscription authentication for the BixBench Opus cell.
# Supply one token form, not both.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_AUTH_TOKEN=

# OpenAI-compatible paper endpoints
KARENINA_PAPER_GPT_OSS_URL=http://host.docker.internal:8101
KARENINA_PAPER_GPT_OSS_120B_URL=http://host.docker.internal:8101/v1
KARENINA_PAPER_QWEN3_5_122B_A10B_URL=http://host.docker.internal:8000
KARENINA_PAPER_QWEN3_5_A3B_URL=http://host.docker.internal:8002
KARENINA_PAPER_QWEN3_6_A3B_URL=http://host.docker.internal:8103
KARENINA_PAPER_VLLM_KEY=EMPTY

# Optional BixBench routes and image overrides
KARENINA_BIX_QWEN_ENDPOINT=
KARENINA_BIX_QWEN_API_KEY=EMPTY
KARENINA_BIX_CLAUDE_CONTAINER_IMAGE=karenina-bixbench-claude:latest
KARENINA_BIX_DEEPAGENTS_CONTAINER_IMAGE=karenina-bixbench:latest

# Optional local Open Targets MCP checkout
KARENINA_PAPER_OTP_MCP_SOURCE=
KARENINA_PAPER_MCP_HOST=127.0.0.1
KARENINA_PAPER_MCP_BASE_PORT=8765
